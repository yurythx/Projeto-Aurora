# Segredos deste arquivo: valores de placeholder, funcionais em dev local
# (docker compose não se importa que "pareçam" um segredo de exemplo), mas
# PÚBLICOS por definição — este arquivo é commitado no git. `config.Load()`
# recusa subir em APP_ENV=production se DB_PASSWORD/RABBITMQ_DEFAULT_PASS
# ainda estiverem nestes valores literais (ver
# backend/internal/platform/config/config.go); gere valores reais antes de
# qualquer ambiente que não seja seu laptop (ex.: `openssl rand -hex 32`).

# Banco de Dados
DB_USER=aurora
DB_PASSWORD=dev-change-this-db-password
DB_NAME=aurora
DB_PORT=5432

# Mensageria / Filas
RABBITMQ_DEFAULT_USER=aurora
RABBITMQ_DEFAULT_PASS=dev-change-this-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=aurora

# Keycloak / Auth OIDC
KEYCLOAK_REALM=aurora
KEYCLOAK_CLIENT_ID=aurora-backend
KEYCLOAK_AUDIENCE=aurora-backend
KEYCLOAK_FRONTEND_CLIENT_ID=aurora-frontend
KEYCLOAK_FRONTEND_CLIENT_SECRET=dev-change-this-keycloak-client-secret

# Autenticacao Local / Backend & NextAuth
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_PRIVATE_KEY_FILE=/run/secrets/local_auth_private_key.pem
# NEXTAUTH_SECRET assina o cookie de sessão do frontend — gere com
# `openssl rand -hex 32` antes de qualquer ambiente real.
NEXTAUTH_SECRET=dev-change-this-nextauth-secret

# CONFIG_ENCRYPTION_KEY cifra (AES-256-GCM) segredos que o menu
# Configurações > Keycloak grava no Postgres em tempo de execução (ver
# backend/internal/platform/secretcrypto e keycloakconfig) — sem ela, o
# backend recusa iniciar em produção (config.Load). Precisa decodificar,
# em base64 padrão, para exatamente 32 bytes: gere com
# `openssl rand -base64 32` antes de qualquer ambiente real; NUNCA rotacione
# sem primeiro resalvar a configuração do Keycloak pela tela (uma chave
# trocada torna o segredo já persistido indecifrável).
CONFIG_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# Object Storage (MinIO)
MINIO_ROOT_USER=aurora_minio_admin
MINIO_ROOT_PASSWORD=dev-change-this-minio-password
MINIO_BUCKET=aurora
MINIO_PUBLIC_URL=http://localhost:9000

# --- Conformidade / Hardening (roadmap de conformidade governamental) ---

# METRICS_SCRAPE_TOKEN (gap G-02): quando definido, GET /metrics exige
# "Authorization: Bearer <token>". Vazio = endpoint aberto (só aceitável
# em dev ou com a porta de métricas em rede interna isolada). Em produção,
# defina um valor forte (`openssl rand -hex 32`) e configure o mesmo no
# scrape do Prometheus. Suporta METRICS_SCRAPE_TOKEN_FILE.
METRICS_SCRAPE_TOKEN=

# TRUSTED_PROXIES (gap G-04): lista de CIDRs (separados por vírgula) dos
# proxies reversos à frente da API. Só quando a conexão TCP vem de uma
# dessas faixas é que o X-Forwarded-For é lido para descobrir o IP real
# do cliente (rate limiter e prova de consentimento LGPD). Vazio = nunca
# confiar em XFF. Ex.: TRUSTED_PROXIES=10.0.0.0/8,172.18.0.0/16
TRUSTED_PROXIES=

# API_RATE_LIMIT_* (gap G-01): teto por identidade autenticada (fallback:
# IP) aplicado a todo o grupo /api/v1. Default: 600 requisições / 60s.
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=600

# AUDIT_WORM_* (F2.6): cópia imutável diária da trilha de auditoria. O
# worker cria AUDIT_WORM_BUCKET com S3 Object Lock (bucket DEDICADO — o
# lock só pode ser habilitado na criação) e aplica retenção Compliance de
# AUDIT_WORM_RETENTION_DAYS a cada objeto. Sem object-lock no provider, o
# worker cai para escrita comum e a cadeia de SHA-256 segue como evidência.
AUDIT_WORM_BUCKET=aurora-audit-worm
AUDIT_WORM_RETENTION_DAYS=1825
