# Banco de Dados
DB_USER=nix
DB_PASSWORD=nix_pass
DB_NAME=nix
DB_PORT=5432

# Mensageria / Filas
RABBITMQ_DEFAULT_USER=nix
RABBITMQ_DEFAULT_PASS=rabbit_pass
RABBITMQ_DEFAULT_VHOST=nix

# Scanners / Integracoes
SCANNING_ZAP_API_KEY=dummy
SONARQUBE_DB_PASSWORD=sonar_pass

# Keycloak / Auth OIDC
KEYCLOAK_REALM=nix
KEYCLOAK_CLIENT_ID=nix-backend
KEYCLOAK_AUDIENCE=nix-backend
KEYCLOAK_FRONTEND_CLIENT_ID=nix-frontend
KEYCLOAK_FRONTEND_CLIENT_SECRET=nix_secret

# Autenticacao Local / Backend & NextAuth
JWT_SECRET=super_secret_jwt_key
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_PRIVATE_KEY_FILE=/run/secrets/local_auth_private_key.pem
NEXTAUTH_SECRET=super_secret_nextauth_key

# Object Storage (MinIO)
MINIO_ROOT_USER=nix_minio_admin
MINIO_ROOT_PASSWORD=minio_secret_password
MINIO_BUCKET=demands

# Motor de Busca (Typesense) — indexação do Diário Oficial (DIORONDON)
# TYPESENSE_URL: usado por api/worker; DENTRO dos containers o compose já
# força http://typesense:8108. Este valor vale para rodar fora do Docker.
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=xyz123secret
# URL pública do Typesense embutida no build do frontend (busca client-side).
TYPESENSE_PUBLIC_URL=http://localhost:8108
